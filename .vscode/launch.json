{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Aparecida Nutrição",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "cwd": "${workspaceFolder}",
      "env": {
        "PORT": "3000"
      },
      "console": "integratedTerminal",
      "preLaunchTask": "Executar testes",
      "serverReadyAction": {
        "pattern": "Aparecida Nutrição disponível na porta (\\d+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    }
  ]
}
